{
  "name": "studio-tecnico-garofalo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/responsive-images.mjs && next build",
    "start": "wrangler pages dev out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app components lib scripts next.config.ts",
    "assets": "node scripts/prepare-assets.mjs",
    "test:contact": "node scripts/test-contact.mjs",
    "predev": "node scripts/responsive-images.mjs",
    "test:contact:unit": "node scripts/test-contact-unit.mjs",
    "pages:deploy": "wrangler pages deploy out"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
